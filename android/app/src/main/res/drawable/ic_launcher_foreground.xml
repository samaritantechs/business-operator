<?xml version="1.0" encoding="utf-8"?>
<!-- THE S MARK, as vectors rather than a PNG.
     An adaptive icon's foreground is a 108x108 canvas of which only the centre 72x72 is
     guaranteed visible: a launcher may crop the rest to a circle, a squircle or a rounded
     square. The group below scales the 100 unit artwork to 66 units and centres it, so the
     mark sits inside that safe zone whatever shape the phone applies.
     Two open arcs, stroked, forming an S: white above, amber below. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:scaleX="0.66" android:scaleY="0.66"
           android:translateX="21" android:translateY="21">
        <path
            android:pathData="M63,22.1 A17,17 0 1 0 50,50"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M50,50 A17,17 0 1 1 33.3,70"
            android:strokeColor="#F0A020"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
