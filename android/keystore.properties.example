# COPY THIS TO android/keystore.properties AND FILL IT IN. That file is git-ignored: it holds
# the password to the one thing in this project that cannot be replaced.
#
# storeFile may be absolute, or relative to the android/ folder. KEEP THE KEYSTORE ITSELF
# OUTSIDE THIS REPOSITORY -- a signing key committed to git is a signing key you have to treat
# as public, and this one has no rotation path.
#
# Windows: forward slashes work here and avoid the doubled-backslash trap.
storeFile=C:/Users/YOURNAME/Documents/keys/samaritan-industrial.jks

# The password you typed when keytool asked, twice. With a PKCS12 keystore -- which is what the
# README's command makes -- the store password IS the key password; there is only one.
storePassword=PUT-YOUR-PASSWORD-HERE
keyAlias=businessoperator
keyPassword=PUT-YOUR-PASSWORD-HERE
