{
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/market", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/app", "destination": "/index.html" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/(market|login|app)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/(.*).html", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] },
    { "source": "/bo/(.*).js", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ]
}
