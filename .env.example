# Copy to .env for the migration scripts, and set the SAME values in Vercel:
# Project Settings -> Environment Variables (Production AND Preview), then redeploy.
#
# Supabase project "business-operator" (eu-west-1) -> Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ^ service_role key, NOT the anon key. The API layer enforces roles itself (api/_lib/auth.js),
#   the same trust model HOPE PMO uses. Never ship this key to a browser.

# Transactional email (Resend, same provider as HOPE PMO). Optional: without it the app runs
# and every email action says plainly that email is not configured.
RESEND_API_KEY=re_...
EMAIL_FROM=Business Operator <samaritantechs@gmail.com>

# Where the app is served -- used inside emails (password-reset links).
APP_URL=https://business-operator.vercel.app

# The one-time setup key. The first person to open a brand-new deployment is asked for this
# before they can create the manager account; after that the setup screen never appears again.
# Any long, unguessable line.
BO_SETUP_KEY=change-me-to-a-long-random-line

# The product name shown on screen, in emails and on PDFs. Optional -- defaults to
# "Samaritan Industrial".
APP_NAME=Samaritan Industrial

# Signs report-download tickets and session tokens' derived secrets. Any long random string.
# If unset, a secret is derived from the service role key (works, but rotate both together).
BO_SECRET=change-me-to-a-long-random-string

WHATSAPP_NUMBER=255756749261
MANAGER_EMAIL=samaritantechs@gmail.com
