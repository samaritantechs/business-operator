// ==================== AUTH ====================
function validateLogin(userId,password){
  try{var sheet=ss.getSheetByName('Users');if(!sheet)return{success:false,message:'Users sheet not found'};var data=sheet.getDataRange().getValues(),input=userId.trim().toLowerCase();
  for(var i=1;i<data.length;i++){var row=data[i],uid=String(row[3]).trim(),email=String(row[0]).trim().toLowerCase(),pwd=String(row[4]).trim(),active=String(row[5]).trim(),role=String(row[2]).trim(),vendor=String(row[6]||'').trim(),match=(uid.toLowerCase()===input||email===input);if(match&&pwd===password.trim()&&active==='Yes')return{success:true,name:row[1],role:role,userId:uid,vendor:vendor,profilePhoto:String(row[7]||'').trim()};}
  return{success:false,message:'Invalid credentials or inactive account.'};}catch(e){return{success:false,message:'Error: '+e.message};}
}

