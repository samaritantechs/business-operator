function requestPasswordReset(email){var sheet=ss.getSheetByName('Users');if(!sheet)return{success:false,message:'Users sheet not found'};var data=sheet.getDataRange().getValues(),userRow=-1;for(var i=1;i<data.length;i++){if(String(data[i][0]).trim().toLowerCase()===email.trim().toLowerCase()){userRow=i+1;break;}}if(userRow===-1)return{success:false,message:'No account found with that email.'};var token=Utilities.getUuid();CacheService.getScriptCache().put('reset_'+token,String(userRow),600);var resetUrl=APP_URL+'?reset='+token;try{MailApp.sendEmail({to:email,subject:'🔑 Password Reset – '+APP_NAME,replyTo:FROM_EMAIL,htmlBody:'<p>Click below to reset your password (valid 10 minutes):</p><p><a href="'+resetUrl+'">'+resetUrl+'</a></p><p>'+APP_NAME+' – '+BRAND_NAME+'</p>'});}catch(e){return{success:false,message:'Could not send email.'};}return{success:true,message:'Reset link sent to '+email+'. Expires in 10 minutes.'};}
