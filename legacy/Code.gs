function ensureLendingsSheet(){var sheet=ss.getSheetByName('Lendings');if(!sheet){sheet=ss.insertSheet('Lendings');sheet.getRange(1,1,1,15).setValues([['LendingID','Timestamp','BorrowerName','BorrowerEmail','BorrowerPhone','ProductID','ProductName','Qty','Price','Total','AdminID','AdminName','Vendor','Status','ReturnDate']]);return sheet;}var headers=sheet.getRange(1,1,1,sheet.getLastColumn()).getValues()[0];if(headers.length<10||headers[8]!=='Price'){sheet.insertColumnAfter(8);sheet.insertColumnAfter(9);sheet.getRange(1,9).setValue('Price');sheet.getRange(1,10).setValue('Total');var lr=sheet.getLastRow();if(lr>1){sheet.getRange(2,9,lr-1,1).setValue(0);sheet.getRange(2,10,lr-1,1).setValue(0);}}return sheet;}
function recordLending(items,borrowerName,borrowerEmail,borrowerPhone,adminId,adminName,vendor){var db=ss.getSheetByName('ProductsDB'),lendSheet=ensureLendingsSheet(),groupId='LEND-'+Utilities.getUuid().substring(0,8).toUpperCase(),timestamp=new Date(),itemNames=[],grandTotal=0;for(var i=0;i<items.length;i++){var item=items[i],pid=item.productId,qty=parseInt(item.qty),price=parseFloat(item.price)||0,lineTotal=qty*price;var data=db.getRange(2,1,Math.max(db.getLastRow()-1,1),9).getValues(),row=-1,stock=0,productName='';for(var j=0;j<data.length;j++){var v=String(data[j][7]||'').trim(),active=String(data[j][8]||'Yes').trim();if(data[j][0]===pid&&active==='Yes'&&(v===''||v===vendor.trim())){row=j+2;productName=data[j][1];stock=Number(data[j][4]);break;}}if(row===-1)return{success:false,message:'Product '+pid+' not found or not active.'};if(stock<qty)return{success:false,message:'Insufficient stock for "'+productName+'". Available: '+stock};db.getRange(row,5).setValue(stock-qty);lendSheet.appendRow([groupId,timestamp,borrowerName,borrowerEmail||'',borrowerPhone||'',pid,productName,qty,price,lineTotal,adminId,adminName,vendor,'Active','']);itemNames.push(qty+'× '+productName+(price>0?' ('+price.toLocaleString('en-TZ')+' each)':''));grandTotal+=lineTotal;}var currency=getVendorCurrency(vendor);if(borrowerEmail&&borrowerEmail.trim()!==''){try{MailApp.sendEmail({to:borrowerEmail,subject:'📋 Lending Confirmation – '+vendor,replyTo:FROM_EMAIL,htmlBody:'<h3>'+APP_NAME+' – Lending Confirmation</h3><p>Dear <strong>'+borrowerName+'</strong>,</p><p>You have borrowed the following from <strong>'+vendor+'</strong>:</p><p style="padding:10px;background:#eef4ff;border-radius:8px;"><strong>'+itemNames.join('<br>')+'</strong></p>'+(grandTotal>0?'<p>Total value: <strong>'+grandTotal.toLocaleString('en-TZ')+' '+currency+'</strong></p>':'')+'<p>Please return at your earliest convenience.</p><p><em>'+APP_NAME+' – '+BRAND_NAME+'</em></p>'});}catch(e){}}return{success:true,message:'Lending recorded for '+borrowerName+'. Items: '+items.length+(grandTotal>0?'. Total owed: '+grandTotal.toLocaleString('en-TZ')+' '+currency:'')+'.'};}
function getLendings(vendor,statusFilter){var sheet=ss.getSheetByName('Lendings');if(!sheet||sheet.getLastRow()<2)return[];ensureLendingsSheet();var data=sheet.getDataRange().getValues(),groups={},order=[];for(var i=1;i<data.length;i++){var r=data[i],rowVendor=String(r[12]||'').trim(),rowStatus=String(r[13]||'').trim();if(vendor!=='ALL'&&rowVendor!==vendor.trim())continue;if(statusFilter&&rowStatus!==statusFilter)continue;var gid=String(r[0]);if(!groups[gid]){groups[gid]={lendingId:gid,timestamp:r[1],borrowerName:String(r[2]||''),borrowerEmail:String(r[3]||''),borrowerPhone:String(r[4]||''),items:[],adminId:String(r[10]||''),adminName:String(r[11]||''),vendor:rowVendor,status:rowStatus,returnDate:r[14]||'',grandTotal:0};order.push(gid);}var lineTotal=Number(r[9])||0;groups[gid].items.push({productId:String(r[5]||''),productName:String(r[6]||''),qty:Number(r[7])||0,price:Number(r[8])||0,total:lineTotal});groups[gid].grandTotal+=lineTotal;}return order.reverse().map(function(gid){return groups[gid];});}
function markLendingReturned(lendingId,vendor){var lendSheet=ss.getSheetByName('Lendings');if(!lendSheet)return{success:false,message:'Lendings sheet not found.'};ensureLendingsSheet();var data=lendSheet.getDataRange().getValues(),db=ss.getSheetByName('ProductsDB'),dbData=db.getDataRange().getValues(),now=new Date(),borrowerEmail='',borrowerName='',found=false;for(var i=1;i<data.length;i++){var r=data[i];if(String(r[0]).trim()===String(lendingId).trim()&&(vendor==='ALL'||String(r[12]||'').trim()===vendor.trim())&&String(r[13]).trim()==='Active'){found=true;borrowerName=String(r[2]||'');borrowerEmail=String(r[3]||'');var pid=String(r[5]),qty=Number(r[7])||0;lendSheet.getRange(i+1,14).setValue('Returned');lendSheet.getRange(i+1,15).setValue(now);var lv=String(r[12]||'').trim();for(var j=1;j<dbData.length;j++){if(String(dbData[j][0])===pid&&(String(dbData[j][7]||'').trim()===lv||String(dbData[j][7]||'').trim()==='')){var ns=Number(dbData[j][4])+qty;db.getRange(j+1,5).setValue(ns);dbData[j][4]=ns;break;}}}}if(!found)return{success:false,message:'Active lending not found.'};if(borrowerEmail&&borrowerEmail.trim()!==''){try{MailApp.sendEmail({to:borrowerEmail,subject:'✅ Return Confirmed – '+vendor,replyTo:FROM_EMAIL,htmlBody:'<p>Dear <strong>'+borrowerName+'</strong>,</p><p>Your borrowing has been marked as <strong>returned</strong>. Thank you!</p><p><em>'+APP_NAME+' – '+BRAND_NAME+'</em></p>'});}catch(e){}}return{success:true,message:'Marked as returned. Stock restored.'};}
function deleteLendingRecord(lendingId,adminId,adminName,vendor){var lendSheet=ss.getSheetByName('Lendings');if(!lendSheet)return{success:false,message:'Lendings sheet not found.'};ensureLendingsSheet();var data=lendSheet.getDataRange().getValues(),db=ss.getSheetByName('ProductsDB'),dbData=db.getDataRange().getValues(),rowsToDelete=[],wasActive=false;for(var i=data.length-1;i>=1;i--){var r=data[i];if(String(r[0]).trim()!==String(lendingId).trim())continue;if(vendor!=='ALL'&&String(r[12]||'').trim()!==vendor.trim())continue;if(String(r[13]).trim()==='Active'){wasActive=true;var pid=String(r[5]),qty=Number(r[7])||0;var lv=String(r[12]||'').trim();for(var j=1;j<dbData.length;j++){if(String(dbData[j][0])===pid&&(String(dbData[j][7]||'').trim()===lv||String(dbData[j][7]||'').trim()==='')){var ns=Number(dbData[j][4])+qty;db.getRange(j+1,5).setValue(ns);dbData[j][4]=ns;break;}}}rowsToDelete.push(i+1);}if(!rowsToDelete.length)return{success:false,message:'Lending record not found.'};rowsToDelete.forEach(function(row){lendSheet.deleteRow(row);});return{success:true,message:'Lending deleted.'+(wasActive?' Stock restored.':' (Was already returned.)')};}
function sendLendingReminders(vendor){var lendings=getLendings(vendor,'Active'),sent=0,noEmail=0,tpl=getLendingReminderText();lendings.forEach(function(l){if(!l.borrowerEmail||l.borrowerEmail.trim()===''){noEmail++;return;}var itemsList=l.items.map(function(it){return it.qty+'× '+it.productName+(it.price>0?' ('+it.price.toLocaleString('en-TZ')+' each)':'');}).join(', ');var daysSince=Math.floor((new Date()-new Date(l.timestamp))/(1000*60*60*24)),currency=getVendorCurrency(l.vendor);var body=_fillTemplate(tpl,{borrowerName:l.borrowerName,vendor:l.vendor,items:itemsList,total:(l.grandTotal>0?(l.grandTotal.toLocaleString('en-TZ')+' '+currency):'—'),currency:currency,days:(daysSince+' day'+(daysSince!==1?'s':''))});try{MailApp.sendEmail({to:l.borrowerEmail,subject:'⏰ Reminder: Borrowed Items – '+l.vendor,replyTo:FROM_EMAIL,htmlBody:body+'<p><em>'+APP_NAME+' – '+BRAND_NAME+'</em></p>'});sent++;}catch(e){}});return{success:true,message:'Sent '+sent+' reminder'+(sent!==1?'s':'')+'. '+(noEmail>0?noEmail+' borrower'+(noEmail!==1?'s':'')+' had no email.':'')};}
function sendSingleLendingReminder(lendingId,vendor){var lendings=getLendings(vendor,'Active'),l=null;for(var i=0;i<lendings.length;i++){if(lendings[i].lendingId===lendingId){l=lendings[i];break;}}if(!l)return{success:false,message:'Active lending not found.'};if(!l.borrowerEmail||l.borrowerEmail.trim()==='')return{success:false,message:'Borrower has no email address on record.'};var itemsList=l.items.map(function(it){return it.qty+'× '+it.productName+(it.price>0?' ('+it.price.toLocaleString('en-TZ')+' each)':'');}).join(', '),daysSince=Math.floor((new Date()-new Date(l.timestamp))/(1000*60*60*24)),currency=getVendorCurrency(l.vendor);var body=_fillTemplate(getLendingReminderText(),{borrowerName:l.borrowerName,vendor:l.vendor,items:itemsList,total:(l.grandTotal>0?(l.grandTotal.toLocaleString('en-TZ')+' '+currency):'—'),currency:currency,days:(daysSince+' day'+(daysSince!==1?'s':''))});try{MailApp.sendEmail({to:l.borrowerEmail,subject:'⏰ Reminder: Borrowed Items – '+l.vendor,replyTo:FROM_EMAIL,htmlBody:body+'<p><em>'+APP_NAME+' – '+BRAND_NAME+'</em></p>'});return{success:true,message:'Reminder sent to '+l.borrowerEmail};}catch(e){return{success:false,message:'Could not send: '+e.message};}}

