function getAnnouncement(){return{enabled:getSetting('announcement_enabled')==='Yes',title:getSetting('announcement_title')||'What\'s New',text:getSetting('announcement_text')||'',audience:getSetting('announcement_audience')||'both',version:getSetting('announcement_version')||''};}
function setAnnouncement(title,text,enabled,audience){setSetting('announcement_title',title||'What\'s New');setSetting('announcement_text',text||'');setSetting('announcement_enabled',enabled?'Yes':'No');setSetting('announcement_audience',audience||'both');setSetting('announcement_version',String(Date.now()));return'Announcement saved.';}
