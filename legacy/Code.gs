// ==================== MARKETPLACE (PUBLIC) ====================
function _getClickMaps(){
  var cache=null;try{cache=CacheService.getScriptCache();}catch(e){}
  if(cache){try{var cached=cache.get('mkClickMaps_v1');if(cached){var o=JSON.parse(cached);if(o&&o.clickMap)return o;}}catch(e){}}
  var clk=ss.getSheetByName('ProductClicks'),clkData=clk&&clk.getLastRow()>1?clk.getDataRange().getValues():[];
  var clickMap={},recentMap={},totalClicks=0,cutoff=(new Date()).getTime()-2592000000;
  for(var ci=1;ci<clkData.length;ci++){var cpid=String(clkData[ci][1]||'');if(!cpid)continue;var cvn=String(clkData[ci][3]||''),ck=cpid+'||'+cvn;clickMap[ck]=(clickMap[ck]||0)+1;totalClicks++;var ts=clkData[ci][0],tv=(ts&&ts.getTime)?ts.getTime():Date.parse(ts);if(tv&&tv>=cutoff)recentMap[ck]=(recentMap[ck]||0)+1;}
  var out={clickMap:clickMap,recentMap:recentMap,totalClicks:totalClicks};
  if(cache){try{var str=JSON.stringify(out);if(str.length<90000)cache.put('mkClickMaps_v1',str,120);}catch(e){}}
  return out;
}
function getMarketplaceData(){
  ensureProductImageColumns();ensureUsersExtraColumns();
  var vendors=getVendors(false),vmap={};
