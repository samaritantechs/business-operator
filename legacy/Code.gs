function getSetting(key){var sheet=ss.getSheetByName('Settings');if(!sheet)return'';var data=sheet.getDataRange().getValues();for(var i=0;i<data.length;i++){if(data[i][0]===key)return String(data[i][1]||'').trim();}return'';}
