function generateSalesReport(startStr,endStr,format,vendor){var salesSheet=ss.getSheetByName('Sales'),sales=salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues();var sd=new Date(startStr),ed=new Date(endStr);ed.setHours(23,59,59,999);var currency=(!vendor||vendor==='ALL')?'TZS':getVendorCurrency(vendor);var usersSheet=ss.getSheetByName('Users'),allUsers=usersSheet?usersSheet.getDataRange().getValues():[],idToName={};for(var i=1;i<allUsers.length;i++){var uid=String(allUsers[i][3]).trim();if(uid)idToName[uid]=String(allUsers[i][1]).trim();}var filtered=sales.filter(function(r){if(!r[1])return false;var d=new Date(r[1]),vm=(!vendor||vendor==='ALL')?true:String(r[10]||'').trim()===vendor.trim();return d>=sd&&d<=ed&&vm;});var tempSS=SpreadsheetApp.create('Sales_'+Utilities.formatDate(sd,'GMT+3','yyyyMMdd')+'_to_'+Utilities.formatDate(ed,'GMT+3','yyyyMMdd')),sh=tempSS.getSheets()[0];sh.getRange('A1').setValue((!vendor||vendor==='ALL'?'All Vendors':vendor)+' – Sales Report').setFontWeight('bold').setFontSize(14);sh.getRange('A2').setValue(Utilities.formatDate(sd,'GMT+3','dd/MM/yyyy')+' – '+Utilities.formatDate(ed,'GMT+3','dd/MM/yyyy'));sh.getRange('A3').setValue('Generated by '+APP_NAME+' – '+BRAND_NAME);sh.getRange('A5:L5').setValues([['#','Sale ID','Timestamp','Seller ID','Seller Name','Product','Qty','Unit Price','Total','Payment','Group ID','Vendor']]).setFontWeight('bold');sh.getRange('A5:L5').setBackground('#1a2236').setFontColor('#ffffff');var grand=0;var rows=filtered.map(function(r,i){var t=Number(r[7])||0;grand+=t;var sid=String(r[2]).trim();return[i+1,r[0],r[1],sid,idToName[sid]||'',r[4],r[5],r[6],t,r[8]||'',r[9]||'',r[10]||''];});if(rows.length)sh.getRange(6,1,rows.length,12).setValues(rows);var gr=6+rows.length;sh.getRange(gr,10).setValue('GRAND TOTAL').setFontWeight('bold');sh.getRange(gr,12).setValue(grand+' '+currency).setFontWeight('bold');sh.autoResizeColumns(1,12);SpreadsheetApp.flush();DriveApp.getFileById(tempSS.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{url:'https://docs.google.com/spreadsheets/d/'+tempSS.getId()+'/export?format='+(format==='excel'?'xlsx':'pdf')};}
function generateStockPDF(vendor){ensureActiveColumn();var db=ss.getSheetByName('ProductsDB'),data=db.getRange(2,1,Math.max(db.getLastRow()-1,1),9).getValues();var currency=(!vendor||vendor==='ALL')?'TZS':getVendorCurrency(vendor);var filtered=data.filter(function(r){var v=String(r[7]||'').trim(),a=String(r[8]||'Yes').trim();return r[0]!==''&&a==='Yes'&&(!vendor||vendor==='ALL'||v===''||v===vendor.trim());});var tempSS=SpreadsheetApp.create('Stock_'+Utilities.formatDate(new Date(),'GMT+3','yyyyMMdd_HHmm')),sh=tempSS.getSheets()[0];sh.getRange('A1').setValue((!vendor||vendor==='ALL'?'All Vendors':vendor)+' – Stock Report').setFontWeight('bold').setFontSize(14);sh.getRange('A3').setValue('Generated: '+Utilities.formatDate(new Date(),'GMT+3','dd/MM/yyyy HH:mm'));sh.getRange('A5:G5').setValues([['ID','Name','Category','Price','Stock','Value','Status']]).setFontWeight('bold');sh.getRange('A5:G5').setBackground('#1a2236').setFontColor('#ffffff');var totalVal=0;var rows=filtered.map(function(r){var val=r[3]*r[4];totalVal+=val;var s='OK';if(r[4]<=0)s='OUT';else if(r[4]<r[6])s='LOW';return[r[0],r[1],r[2],r[3],r[4],val,s];});if(rows.length)sh.getRange(6,1,rows.length,7).setValues(rows);var gr=6+rows.length;sh.getRange(gr,6).setValue('TOTAL').setFontWeight('bold');sh.getRange(gr,7).setValue(totalVal+' '+currency).setFontWeight('bold');sh.autoResizeColumns(1,7);SpreadsheetApp.flush();DriveApp.getFileById(tempSS.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{url:'https://docs.google.com/spreadsheets/d/'+tempSS.getId()+'/export?format=pdf'};}
function generateCashDuePDF(vendor){var usersSheet=ss.getSheetByName('Users'),salesSheet=ss.getSheetByName('Sales'),sales=salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues(),ct=ss.getSheetByName('CashTracking').getDataRange().getValues(),today=new Date(),todayStr=today.toDateString(),currency=(!vendor||vendor==='ALL')?'TZS':getVendorCurrency(vendor);var activeSellers=usersSheet.getDataRange().getValues().filter(function(r,i){if(!vendor||vendor==='ALL')return i>0&&r[5]==='Yes'&&r[2]==='seller';return i>0&&r[5]==='Yes'&&r[2]==='seller'&&String(r[6]||'').trim()===vendor.trim();});var tempSS=SpreadsheetApp.create('CashDue_'+Utilities.formatDate(today,'GMT+3','yyyyMMdd')),sh=tempSS.getSheets()[0];sh.getRange('A1').setValue((!vendor||vendor==='ALL'?'All Vendors':vendor)+' – Cash Due Report').setFontWeight('bold').setFontSize(14);sh.getRange('A2').setValue(Utilities.formatDate(today,'GMT+3','dd/MM/yyyy'));sh.getRange('A4:F4').setValues([['Seller','Cash Sales','Lipa Sales','Cash Received','Lipa Received','Balance']]).setFontWeight('bold');sh.getRange('A4:F4').setBackground('#1a2236').setFontColor('#ffffff');var rows=[],grandBalance=0;activeSellers.forEach(function(u){var sid=u[3],sname=u[1],cashSales=0,lipaSales=0,cashRec=0,lipaRec=0;sales.forEach(function(r){if(r[2]===sid&&String(r[10]||'').trim()===(vendor||'')&&new Date(r[1]).toDateString()===todayStr){var t=Number(r[7])||0;if(r[8]==='Cash')cashSales+=t;else if(r[8]==='Lipa Number')lipaSales+=t;else cashSales+=t;}});for(var j=1;j<ct.length;j++){if(ct[j][1]===sid&&String(ct[j][5]||'').trim()===(vendor||'')&&new Date(ct[j][0]).toDateString()===todayStr){cashRec+=Number(ct[j][2])||0;lipaRec+=Number(ct[j][3])||0;}}if(lipaRec===0)lipaRec=lipaSales;var balance=cashSales-cashRec+lipaSales-lipaRec;grandBalance+=balance;rows.push([sname+' ('+sid+')',cashSales,lipaSales,cashRec,lipaRec,balance]);});if(rows.length)sh.getRange(5,1,rows.length,6).setValues(rows);var gr=5+rows.length;sh.getRange(gr,5).setValue('TOTAL').setFontWeight('bold');sh.getRange(gr,6).setValue(grandBalance+' '+currency).setFontWeight('bold');sh.autoResizeColumns(1,6);SpreadsheetApp.flush();DriveApp.getFileById(tempSS.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{url:'https://docs.google.com/spreadsheets/d/'+tempSS.getId()+'/export?format=pdf'};}
function generateLendingReport(startStr,endStr,statusFilter,vendor){var lendSheet=ss.getSheetByName('Lendings');ensureLendingsSheet();var data=lendSheet&&lendSheet.getLastRow()>1?lendSheet.getDataRange().getValues():[];var sd=new Date(startStr),ed=new Date(endStr);ed.setHours(23,59,59,999);var currency=(!vendor||vendor==='ALL')?'TZS':getVendorCurrency(vendor);var filtered=[];for(var i=1;i<data.length;i++){var r=data[i];var rv=String(r[12]||'').trim(),rs=String(r[13]||'').trim(),rd=new Date(r[1]);if(vendor&&vendor!=='ALL'&&rv!==vendor)continue;if(statusFilter&&statusFilter!=='ALL'&&rs!==statusFilter)continue;if(rd<sd||rd>ed)continue;filtered.push(r);}var tempSS=SpreadsheetApp.create('Lending_Report_'+Utilities.formatDate(new Date(),'GMT+3','yyyyMMdd')),sh=tempSS.getSheets()[0];sh.getRange('A1').setValue((!vendor||vendor==='ALL'?'All Vendors':vendor)+' – Lending Report ('+(statusFilter||'ALL')+')').setFontWeight('bold').setFontSize(14);sh.getRange('A2').setValue(Utilities.formatDate(sd,'GMT+3','dd/MM/yyyy')+' – '+Utilities.formatDate(ed,'GMT+3','dd/MM/yyyy'));sh.getRange('A4:J4').setValues([['Lending ID','Date','Borrower','Email','Phone','Product','Qty','Unit Price','Total','Status']]).setFontWeight('bold');sh.getRange('A4:J4').setBackground('#1a2236').setFontColor('#ffffff');var grandTotal=0,rows=filtered.map(function(r){var t=Number(r[9])||0;grandTotal+=t;return[r[0],r[1],r[2],r[3],r[4],r[6],r[7],r[8],t,r[13]];});if(rows.length)sh.getRange(5,1,rows.length,10).setValues(rows);var gr=5+rows.length;sh.getRange(gr,8).setValue('GRAND TOTAL').setFontWeight('bold');sh.getRange(gr,9).setValue(grandTotal+' '+currency).setFontWeight('bold');sh.autoResizeColumns(1,10);SpreadsheetApp.flush();DriveApp.getFileById(tempSS.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{url:'https://docs.google.com/spreadsheets/d/'+tempSS.getId()+'/export?format=pdf'};}
function generateCommissionReport(startStr,endStr,vendor){var rate=getCommissionRate(),salesSheet=ss.getSheetByName('Sales');var allSales=salesSheet?salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues():[];var sd=new Date(startStr),ed=new Date(endStr);ed.setHours(23,59,59,999);var vendors=getVendors(true);var tempSS=SpreadsheetApp.create('Commission_Report_'+Utilities.formatDate(new Date(),'GMT+3','yyyyMMdd')),sh=tempSS.getSheets()[0];sh.getRange('A1').setValue('Commission Report – '+Utilities.formatDate(sd,'GMT+3','dd/MM/yyyy')+' to '+Utilities.formatDate(ed,'GMT+3','dd/MM/yyyy')).setFontWeight('bold').setFontSize(14);sh.getRange('A2').setValue('Commission Rate: '+rate+'%');sh.getRange('A4:G4').setValues([['Vendor','Admin','Status','Currency','Total Sales','Commission Rate','Commission Due']]).setFontWeight('bold');sh.getRange('A4:G4').setBackground('#1a2236').setFontColor('#ffffff');var rows=[],grandComm=0;vendors.forEach(function(v){if(vendor&&vendor!=='ALL'&&v.name!==vendor)return;var total=0;allSales.forEach(function(s){if(String(s[10]||'').trim()===v.name){var d=new Date(s[1]);if(d>=sd&&d<=ed)total+=Number(s[7])||0;}});var comm=total*(rate/100);grandComm+=comm;var curr=getVendorCurrency(v.name);rows.push([v.name,v.adminName,(v.active==='Yes'?'Active':'Inactive'),curr,total,rate+'%',comm]);});if(rows.length)sh.getRange(5,1,rows.length,7).setValues(rows);var gr=5+rows.length;sh.getRange(gr,6).setValue('TOTAL COMMISSION DUE').setFontWeight('bold');sh.getRange(gr,7).setValue(grandComm).setFontWeight('bold');sh.autoResizeColumns(1,7);SpreadsheetApp.flush();DriveApp.getFileById(tempSS.getId()).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);return{url:'https://docs.google.com/spreadsheets/d/'+tempSS.getId()+'/export?format=pdf'};}

