function checkAndSendCommissionDemand(){var rate=getCommissionRate();if(rate<=0)return 0;var trialDays=getTrialDays();var vendors=getVendors(false),now=new Date();var salesSheet=ss.getSheetByName('Sales'),allSales=salesSheet?salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues():[],sent=0;vendors.forEach(function(v){if(v.active!=='Yes'||!v.email)return;if(v.registeredOn){var _ds=Math.floor((now-new Date(v.registeredOn))/86400000);if(_ds<trialDays)return;}var pStart=_cyclePeriodStart(v.registeredOn,now),total=0;allSales.forEach(function(s){if(String(s[10]||'').trim()===v.name&&new Date(s[1])>=pStart)total+=Number(s[7])||0;});var due=total*(rate/100);if(due>0){try{MailApp.sendEmail({to:v.email,bcc:MANAGER_EMAILS,replyTo:FROM_EMAIL,subject:'💼 Commission Invoice – '+v.name+' – '+Utilities.formatDate(now,'GMT+3','MMMM yyyy'),htmlBody:'<h2>Commission Notice</h2><p>Dear '+v.adminName+',</p><table border="1" cellpadding="6" style="border-collapse:collapse;"><tr><th>Total Sales</th><td>'+total.toLocaleString('en-TZ')+' '+getVendorCurrency(v.name)+'</td></tr><tr><th>Rate</th><td>'+rate+'%</td></tr><tr><th>Due</th><td><strong>'+due.toLocaleString('en-TZ')+' '+getVendorCurrency(v.name)+'</strong></td></tr></table><p>Remit to <strong>'+BRAND_NAME+'</strong>.</p>'});sent++;}catch(e){}}});return sent; }

