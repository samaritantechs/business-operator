function ensureDefaultHints(){var sheet=ss.getSheetByName('Hints');if(!sheet){sheet=ss.insertSheet('Hints');sheet.getRange(1,1).setValue('Role');sheet.getRange(1,2).setValue('Message');}if(sheet.getLastColumn()<3||String(sheet.getRange(1,3).getValue()).trim()!=='SW-MESSAGE')sheet.getRange(1,3).setValue('SW-MESSAGE');var data=sheet.getDataRange().getValues();if(data.length<=1){var defaults=[['seller',"💡 Your User ID is your login – use it every time you sell."],['seller',"🛒 Always select product and quantity before submitting."],['seller',"💰 Cash='Cash', mobile='Lipa Number'."],['seller',"📦 Check Stock for low products."],['seller',"🔒 Keep your password safe – never share it."],['seller',"📥 Download your sales reports from the Reports tab."],['seller',"🔄 Use Refresh to see the latest numbers."],['seller',"📋 Use Lendings tab to record and track borrowed items."],['admin',"👥 Add or edit users in the Users tab."],['admin',"📦 Add products, photos or increase stock in the Products tab."],['admin',"🛍️ Add 1–2 photos per product so it shines in the marketplace."],['admin',"💰 Record cash payments from sellers in Cash tab."],['admin',"📊 Seller balances show who owes what today."],['admin',"📥 Download sales, stock, or cash due reports anytime."],['admin',"🏷️ Set your Business Type & contact in the Users tab profile."],['admin',"📋 Use Lendings to record and track borrowed items."],['admin',"🗑️ Delete sale or lending records directly from the dashboard."]];defaults.forEach(function(d){sheet.appendRow(d);});}return'OK';}


// ==================== MONETIZATION: TRIAL / RESTRICTION / REMINDER TEMPLATES ====================
function getTrialDays(){var n=parseInt(getSetting('trialDays'));return(isNaN(n)||n<0)?60:n;}
function setTrialDays(d){var n=parseInt(d);if(isNaN(n)||n<0)n=60;setSetting('trialDays',n);return'OK';}
function trialDaysRemaining(registeredOn){if(!registeredOn)return null;var td=getTrialDays();var days=Math.floor((new Date()-new Date(registeredOn))/86400000);return td-days;}
function _cyclePeriodStart(anchor,now){if(!anchor)return new Date(now.getFullYear(),now.getMonth(),1);var a=new Date(anchor);if(isNaN(a.getTime()))return new Date(now.getFullYear(),now.getMonth(),1);if(a>now)return a;var d=new Date(a.getTime());while(true){var nx=new Date(d.getFullYear(),d.getMonth()+1,d.getDate(),d.getHours(),d.getMinutes(),d.getSeconds());if(nx>now)break;d=nx;}return d;}
function _resetCycleIfReactivating(row,newActive){try{if(String(newActive)!=='Yes')return;var s=ss.getSheetByName('Users');var role=String(s.getRange(row,3).getValue()).trim();var cur=String(s.getRange(row,6).getValue()).trim();if(role==='admin'&&cur!=='Yes'){ensureUsersExtraColumns();s.getRange(row,12).setValue(new Date());}}catch(e){}}

function getVendorRestricted(vendor){return getSetting('restricted_'+vendor)==='Yes'?'Yes':'No';}
function setVendorRestricted(vendor,status){setSetting('restricted_'+vendor,(String(status)==='Yes'?'Yes':'No'));return{success:true,message:(String(status)==='Yes'?('Account RESTRICTED: '+vendor+'. Owner and sellers now see the payment notice and cannot act until reactivated.'):('Account REACTIVATED: '+vendor+'. Full access restored.'))};}

var _DEFAULT_PAYMENT_TEXT='⚠️ Your account is currently restricted because of an outstanding payment. To restore full access, please settle your balance with '+BRAND_NAME+' and your account will be reactivated. Use the feedback button at the top of the page to reach us.';
var _DEFAULT_LENDING_TEXT='<h3>Lending Reminder</h3><p>Dear <strong>{borrowerName}</strong>,</p><p>You still have borrowed from <strong>{vendor}</strong>:</p><p style="padding:10px;background:#fff3cd;border-radius:8px;"><strong>{items}</strong></p><p>Total owed: <strong>{total}</strong></p><p>Borrowed <strong>{days}</strong> ago. Please return at your earliest convenience.</p>';

function getPaymentReminderText(){var t=getSetting('paymentReminderText');return t&&t.trim()!==''?t:_DEFAULT_PAYMENT_TEXT;}
function setPaymentReminderText(t){setSetting('paymentReminderText',t||'');return'OK';}
function getLendingReminderText(){var t=getSetting('lendingReminderText');return t&&t.trim()!==''?t:_DEFAULT_LENDING_TEXT;}
function setLendingReminderText(t){setSetting('lendingReminderText',t||'');return'OK';}
function _fillTemplate(tpl,map){var out=String(tpl||'');Object.keys(map).forEach(function(k){out=out.split('{'+k+'}').join(map[k]==null?'':String(map[k]));});return out;}

function getRestrictionInfo(vendor){var restricted=getVendorRestricted(vendor)==='Yes';if(!restricted)return{restricted:false,notice:''};var rate=getCommissionRate(),now=new Date();var admin='',anchor='';var vs=getVendors(true);for(var i=0;i<vs.length;i++){if(vs[i].name===vendor){admin=vs[i].adminName;anchor=vs[i].registeredOn||'';break;}}var pStart=_cyclePeriodStart(anchor,now);var salesSheet=ss.getSheetByName('Sales'),allSales=salesSheet?salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues():[];var total=0;allSales.forEach(function(s){if(String(s[10]||'').trim()===vendor&&new Date(s[1])>=pStart)total+=Number(s[7])||0;});var due=total*(rate/100),currency=getVendorCurrency(vendor);var notice=_fillTemplate(getPaymentReminderText(),{vendor:vendor,admin:admin,amount:(due>0?due.toLocaleString('en-TZ'):'0'),currency:currency});return{restricted:true,notice:notice};}

function sendPaymentRemindersToRestricted(){var vendors=getVendors(true),tpl=getPaymentReminderText(),rate=getCommissionRate(),now=new Date();var salesSheet=ss.getSheetByName('Sales'),allSales=salesSheet?salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues():[];var sent=0,skipped=0;vendors.forEach(function(v){if(getVendorRestricted(v.name)!=='Yes')return;if(!v.email||v.email.trim()===''){skipped++;return;}var pStart=_cyclePeriodStart(v.registeredOn,now),total=0;allSales.forEach(function(s){if(String(s[10]||'').trim()===v.name&&new Date(s[1])>=pStart)total+=Number(s[7])||0;});var due=total*(rate/100);var currency=getVendorCurrency(v.name);var body=_fillTemplate(tpl,{vendor:v.name,admin:v.adminName,amount:(due>0?due.toLocaleString('en-TZ'):'0'),currency:currency});try{MailApp.sendEmail({to:v.email,bcc:MANAGER_EMAILS,replyTo:FROM_EMAIL,subject:'🔒 Payment Required – '+v.name,htmlBody:body+'<p><em>'+APP_NAME+' – '+BRAND_NAME+'</em></p>'});sent++;}catch(e){}});return{success:true,message:'Sent '+sent+' payment reminder'+(sent!==1?'s':'')+' to restricted account'+(sent!==1?'s':'')+'.'+(skipped>0?(' '+skipped+' restricted vendor'+(skipped!==1?'s':'')+' had no email.'):'')};}
function mgrSendPaymentRemindersNow(){try{return sendPaymentRemindersToRestricted();}catch(e){return{success:false,message:'Error: '+e.message};}}


