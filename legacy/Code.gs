function _sendReportToVendor(v,startStr,endStr,labelType,todayStr){if(v.active!=='Yes'||!v.email||v.email.trim()==='')return;var profile=getPermissionProfile(v.name);if(labelType==='daily'&&!profile.adminReceivesDaily)return;if(labelType==='weekly'&&!profile.adminReceivesWeekly)return;if(labelType==='monthly'&&!profile.adminReceivesMonthly)return;try{var pdfUrl=generateSalesReport(startStr,endStr,'pdf',v.name).url;var pdfBlob=UrlFetchApp.fetch(pdfUrl,{headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()}}).getBlob();pdfBlob.setName(labelType.charAt(0).toUpperCase()+labelType.slice(1)+'_Report_'+v.name+'_'+todayStr+'.pdf');MailApp.sendEmail({to:v.email,subject:'📊 '+labelType.charAt(0).toUpperCase()+labelType.slice(1)+' Sales Report – '+v.name+' ('+todayStr+')',htmlBody:'<p>Dear '+v.adminName+',</p><p>Please find attached your '+labelType+' sales report.</p><p>'+APP_NAME+' – '+BRAND_NAME+'</p>',attachments:[pdfBlob],replyTo:FROM_EMAIL});}catch(e){console.error('Report email error: '+e.message);}}
function _sendReportToSellers(vendorName,startStr,endStr,labelType,todayStr){var profile=getPermissionProfile(vendorName);if(!profile.sellerReceivesEmail)return;if(labelType==='daily'&&!profile.sellerReceivesDaily)return;var usersSheet=ss.getSheetByName('Users'),data=usersSheet.getDataRange().getValues(),salesSheet=ss.getSheetByName('Sales'),allSales=salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues();var sd=new Date(startStr),ed=new Date(endStr);ed.setHours(23,59,59,999);for(var i=1;i<data.length;i++){var u=data[i];if(String(u[2]).trim()==='seller'&&String(u[5]).trim()==='Yes'&&String(u[6]||'').trim()===vendorName&&u[0]){var sellerSales=allSales.filter(function(s){var d=new Date(s[1]);return d>=sd&&d<=ed&&s[2]===u[3]&&String(s[10]||'').trim()===vendorName;});var total=sellerSales.reduce(function(acc,s){return acc+Number(s[7])||0;},0);try{MailApp.sendEmail({to:u[0],subject:'📋 Your '+labelType+' Sales Summary – '+todayStr,replyTo:FROM_EMAIL,htmlBody:'<p>Dear '+u[1]+',</p><p>Your <strong>'+labelType+'</strong> sales: <strong>'+total.toLocaleString('en-TZ')+' '+getVendorCurrency(vendorName)+'</strong></p><p>'+vendorName+' via '+APP_NAME+'</p>'});}catch(e){}}}}
function sendDailyReportsToAdmins(){var vendors=getVendors(false),now=new Date();var ts=Utilities.formatDate(now,'GMT+3','yyyy-MM-dd');var s2=Utilities.formatDate(new Date(now.getFullYear(),now.getMonth(),now.getDate()-1),'GMT+3','yyyy-MM-dd');vendors.forEach(function(v){_sendReportToVendor(v,s2,ts,'daily',ts);_sendReportToSellers(v.name,s2,ts,'daily',ts);});}
function sendWeeklyReportsToAdmins(){var vendors=getVendors(false),now=new Date();var e=Utilities.formatDate(now,'GMT+3','yyyy-MM-dd');var s=Utilities.formatDate(new Date(now.getFullYear(),now.getMonth(),now.getDate()-7),'GMT+3','yyyy-MM-dd');vendors.forEach(function(v){_sendReportToVendor(v,s,e,'weekly',e);});}
function sendMonthlyReportsToAdmins(){var vendors=getVendors(false),now=new Date();var e=Utilities.formatDate(now,'GMT+3','yyyy-MM-dd');var s=Utilities.formatDate(new Date(now.getFullYear(),now.getMonth()-1,now.getDate()),'GMT+3','yyyy-MM-dd');vendors.forEach(function(v){_sendReportToVendor(v,s,e,'monthly',e);});}
function sendManagerDailySummary(){var data=getManagerDashboardData();MailApp.sendEmail({to:MANAGER_EMAILS,replyTo:FROM_EMAIL,subject:'📊 Daily Vendor Summary – '+Utilities.formatDate(new Date(),'GMT+3','yyyy-MM-dd'),htmlBody:'<h2>'+APP_NAME+' – Daily Summary</h2><p>'+Utilities.formatDate(new Date(),'GMT+3','yyyy-MM-dd')+'</p><table border="1" cellpadding="4" style="border-collapse:collapse;"><thead><tr><th>Vendor</th><th>Admin</th><th>Today</th><th>Weekly</th><th>Monthly</th><th>Products</th><th>Sellers</th><th>Stock Value</th></tr></thead><tbody>'+data.vendorRows+'</tbody></table><p>'+BRAND_NAME+'</p>'});}

// ==================== SUGGESTIONS (legacy/no-email; feedback now via WhatsApp) ====================
function submitSuggestion(userId,userName,vendorName,message,category){var sheet=ss.getSheetByName('Suggestions');if(!sheet){sheet=ss.insertSheet('Suggestions');sheet.getRange(1,1,1,6).setValues([['Timestamp','UserId','UserName','Vendor','Category','Message']]);}sheet.appendRow([new Date(),userId,userName,vendorName,category||'General',message]);return'Thank you! Your suggestion has been saved.';}
function getSuggestions(){var sheet=ss.getSheetByName('Suggestions');if(!sheet)return[];var data=sheet.getDataRange().getValues(),list=[];for(var i=1;i<data.length;i++){var r=data[i];list.push({timestamp:r[0],userId:r[1],userName:r[2],vendor:r[3],category:r[4],message:r[5]});}return list.reverse();}

// ==================== VENDOR / REGISTRATION ====================
function registerVendor(name,adminEmail,adminName,adminUserId,adminPassword,businessType,phone,address){var sheet=ss.getSheetByName('Users');if(!sheet)return'System error: Users sheet not found.';var data=sheet.getDataRange().getValues();for(var i=1;i<data.length;i++){if(String(data[i][0]).trim().toLowerCase()===adminEmail.trim().toLowerCase())return'An account with this email already exists. Please use a different email or login instead.';}var freeReg=getSetting('FreeRegistration'),activeStatus=(freeReg==='Yes')?'Yes':'No';ensureUsersExtraColumns();sheet.appendRow([adminEmail,adminName,'admin',adminUserId,adminPassword,activeStatus,name,'',businessType||'',phone||'',address||'',new Date()]);return activeStatus==='Yes'?'Business registered! You can now log in.':'Registration submitted. The system manager will activate your account.';}
function getVendors(includeInactive){var usersSheet=ss.getSheetByName('Users'),data=usersSheet.getDataRange().getValues(),vendors={};for(var i=1;i<data.length;i++){var vendor=String(data[i][6]||'').trim(),role=String(data[i][2]).trim(),active=String(data[i][5]).trim();if(vendor!==''&&role==='admin'){if(includeInactive||active==='Yes'){if(!vendors[vendor])vendors[vendor]={name:vendor,adminId:data[i][3],adminName:data[i][1],active:active,email:data[i][0],businessType:String(data[i][8]||''),phone:String(data[i][9]||''),address:String(data[i][10]||''),registeredOn:data[i][11]||''};}}}return Object.values(vendors);}
function getVendorList(){return getVendors(false).map(function(v){return v.name;});}
function toggleVendorAdmin(vendorName,activeStatus){var sheet=ss.getSheetByName('Users'),data=sheet.getDataRange().getValues();for(var i=1;i<data.length;i++){if(String(data[i][6]||'').trim()===vendorName&&String(data[i][2]).trim()==='admin')sheet.getRange(i+1,6).setValue(activeStatus);}return'Vendor status updated.';}

// ==================== SALES DETAIL ====================
function getSalesDetail(period,vendor){var salesSheet=ss.getSheetByName('Sales'),allSales=salesSheet.getRange(2,1,Math.max(salesSheet.getLastRow()-1,1),11).getValues();var usersSheet=ss.getSheetByName('Users'),allUsers=usersSheet.getDataRange().getValues(),idToName={};for(var i=1;i<allUsers.length;i++){var uid=String(allUsers[i][3]).trim();if(uid)idToName[uid]=String(allUsers[i][1]).trim();}var currency=(!vendor||vendor==='ALL')?'TZS':getVendorCurrency(vendor);var now=new Date(),startDate=new Date(now.getFullYear(),now.getMonth(),now.getDate());if(period==='week'){var dy=now.getDay();startDate=new Date(now.getFullYear(),now.getMonth(),now.getDate()-dy+(dy===0?-6:1));}else if(period==='month')startDate=new Date(now.getFullYear(),now.getMonth(),1);else if(period==='stock'){var db=ss.getSheetByName('ProductsDB'),products=db.getRange(2,1,Math.max(db.getLastRow()-1,1),9).getValues();var html='<div class="table-wrap"><table class="bo-table"><thead><tr><th>ID</th><th>Product</th><th>Stock</th><th>Price</th><th>Value</th><th>Status</th></tr></thead><tbody>';products.forEach(function(r){if(!r[0])return;var v=String(r[7]||'').trim(),a=String(r[8]||'Yes').trim();if(vendor&&vendor!=='ALL'&&v!==''&&v!==vendor.trim())return;if(a!=='Yes')return;var val=r[3]*r[4];var s='<span class="badge-status badge-ok">✅ OK</span>';if(r[4]<=0)s='<span class="badge-status badge-out">🔴 OUT</span>';else if(r[4]<r[6])s='<span class="badge-status badge-low">⚠️ LOW</span>';html+='<tr><td>'+r[0]+'</td><td>'+r[1]+'</td><td>'+r[4]+'</td><td>'+Number(r[3]).toLocaleString('en-TZ')+'</td><td>'+val.toLocaleString('en-TZ')+'</td><td>'+s+'</td></tr>';});return html+'</tbody></table></div>';}startDate.setHours(0,0,0,0);var endDate=new Date(now.getFullYear(),now.getMonth(),now.getDate(),23,59,59);var filtered=allSales.filter(function(r){if(!r[1])return false;var d=new Date(r[1]),vm=(!vendor||vendor==='ALL')?true:String(r[10]||'').trim()===vendor.trim();return d>=startDate&&d<=endDate&&vm;});if(!filtered.length)return'<p style="color:var(--muted);">No sales in this period.</p>';var groups={};filtered.forEach(function(r){var sid=String(r[2]).trim(),sn=idToName[sid]||sid;if(!groups[sn])groups[sn]={rows:[],total:0};groups[sn].rows.push(r);groups[sn].total+=Number(r[7])||0;});var grandTotal=0,html='';Object.keys(groups).sort().forEach(function(sn){var g=groups[sn];html+='<h6 style="margin:16px 0 8px;color:var(--text);">🧑 '+sn+' – <span style="color:var(--accent2);">'+g.total.toLocaleString('en-TZ')+' '+currency+'</span></h6>';html+='<div class="table-wrap"><table class="bo-table"><thead><tr><th>Time</th><th>Product</th><th>Qty</th><th>Price</th><th>Total</th><th>Payment</th></tr></thead><tbody>';g.rows.forEach(function(r){html+='<tr><td>'+new Date(r[1]).toLocaleTimeString()+'</td><td>'+r[4]+'</td><td>'+r[5]+'</td><td>'+Number(r[6]).toLocaleString('en-TZ')+'</td><td>'+Number(r[7]).toLocaleString('en-TZ')+' '+currency+'</td><td>'+r[8]+'</td></tr>';});html+='</tbody></table></div>';grandTotal+=g.total;});html+='<div style="text-align:right;margin-top:16px;font-weight:700;font-size:1.05rem;">Grand Total: '+grandTotal.toLocaleString('en-TZ')+' '+currency+'</div>';return html;}

